    "ajv-formats": "^3.0.1",
    "ora": "^5.4.1",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^24.7.0",
    "@types/js-yaml": "^4.0.9",
